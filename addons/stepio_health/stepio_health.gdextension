; Native HealthKit code for iOS. Built from ios/ (see README). Android uses the
; AAR plugin in bin/android instead, and desktop runs use a fake step source.

[configuration]

entry_symbol = "stepio_health_library_init"
compatibility_minimum = "4.5"

[libraries]

ios.debug = "res://addons/stepio_health/bin/ios/libstepio_health.ios.template_debug.arm64.dylib"
ios.release = "res://addons/stepio_health/bin/ios/libstepio_health.ios.template_release.arm64.dylib"
